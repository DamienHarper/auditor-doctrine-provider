{
  "name": "damienharper/auditor-doctrine-provider-migration-e2e-v1",
  "description": "Writes audit entries with auditor-doctrine-provider 1.x, for the end-to-end test of the migration to 2.x.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "damienharper/auditor-doctrine-provider": "1.x-dev",
    "symfony/event-dispatcher": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "DH\\Auditor\\Tests\\MigrationE2E\\Fixtures\\": "../../../tests/MigrationE2E/Fixtures/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
